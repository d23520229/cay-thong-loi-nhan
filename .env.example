# Sao chép thành .env rồi điền giá trị. Không đưa file .env lên git.
PORT=3000
# Khi phát triển dùng cổng Vite (5173); web proxy /api và /og sang server cổng 3000
BASE_URL=http://localhost:5173
DATABASE_URL=postgres://ctln:ctln_dev@localhost:5432/caythong

# Chuỗi bí mật dùng để băm khoá, phiên, token (tạo ngẫu nhiên, dài ≥ 32 ký tự)
# Production bắt buộc PEPPER và BLOCK_IP_KEY đều là chuỗi ngẫu nhiên ≥ 32 ký tự.
PEPPER=
# Muối băm IP đổi hằng ngày được sinh tự động; khoá cố định cho danh sách chặn IP:
BLOCK_IP_KEY=

# Đăng nhập Google (Google Cloud Console → OAuth client ID loại Web)
GOOGLE_CLIENT_ID=

# Quản trị viên đầu tiên
ADMIN_BOOTSTRAP_EMAIL=
# Email hỗ trợ hiện cho người dùng (chân trang chủ, thông báo khi kẹt)
SUPPORT_EMAIL=
# Hạn mức dung lượng CSDL (GB) để so trên trang quản trị
DB_QUOTA_GB=32
# Đường dẫn Azure Portal (resource group) cho CPU / bộ nhớ / chi phí — đặt ở M4
ADMIN_AZURE_URL=

# Mốc thời gian (giờ Việt Nam)
UNLOCK_AT=2026-12-24T00:00:00+07:00
WRITE_CLOSES_AT=2026-12-26T00:00:00+07:00
SERVICE_ENDS_AT=2027-01-01T00:00:00+07:00
PURGE_AT=2027-01-07T00:00:00+07:00
# Chỉ dùng khi phát triển / thử nghiệm: giả lập "bây giờ"
FAKE_NOW=

# Thư mục bản build web (apps/web/dist). Có thì server phục vụ luôn trang + chèn thẻ OG cho /c/:id (đặc tả 6.6.3).
# Để trống khi phát triển bằng `pnpm dev` (Vite phục vụ trang).
WEB_DIST=

# Số bước proxy tin cậy khi đọc X-Forwarded-For (Azure App Service = 1)
TRUST_PROXY_HOPS=1

# Thư mục lưu ảnh đính kèm khi chạy không có Azure Blob (mặc định .data/photos)
PHOTO_DIR=

# Chuỗi kết nối Azure Blob Storage. Có thì ảnh lưu ở Blob (container riêng tư "photos"); để trống thì lưu vào PHOTO_DIR
AZURE_STORAGE_CONNECTION_STRING=
